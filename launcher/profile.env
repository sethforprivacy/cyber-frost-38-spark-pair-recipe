# CYBER-FROST-3.8-NVFP4-V2 production profile on the two-Spark pair (vLLM TP2), as served since 2026-10-03.
# Read by pair-up.sh, which passes every line to vllm-rank.sh as environment. KEY=VALUE only, one per line,
# comments on their own lines (an inline comment would become part of the value).
#
# History (README "What each change does"):
#   2026-09-29 launch: V1 checkpoint as published, 2 seats, 262,144 context, BF16 KV 8 GB/rank, 2,048 batched tokens.
#   2026-09-30: w1/w3 scale fold (V1 only), FP8 PLE, draft-only NVFP4 head, upstream bundle, YaRN 524,288, FP8 KV.
#   2026-10-01: skinny decode GEMM with GB10 plans, FP8 dense projections + head, pinned MoE tactics, 48K draft
#     vocabulary, 16 seats, dual-rail NCCL, RoCEnante all-reduce.
#   2026-10-03: V2 checkpoint (shared gate/up scales), Marlin W4A16 routed experts, MTP drafter quantized.
# Rollback: profile.rollback-20261001.env (FlashInfer CUTLASS W4A4 experts, BF16 MTP layer; view built with MTP=0).

PORT=8901
MODEL_NAME=CYBER-FROST-3.8-NVFP4
# W4A16 routed experts (BF16 activations): NLL -0.006, decode step -3.4 %, prefill -3..-15 % vs FlashInfer CUTLASS W4A4.
MOE_BACKEND=marlin
# 2,825,969 tokens of FP8 KV per rank pair (5.39 x 524,288).
KV_BYTES=24000000000
MAX_LEN=524288
MAX_SEQS=16
BATCHED=8192
SPEC_K=3
OVERLAY_SETS=vllm-upstream,vllm-gb10,vllm-draft,vllm-roce
# b12x checkout for RoCEnante: $B12X_ROOT/e4084d2e at local-inference-lab/b12x e4084d2eef4932e0fa06db3f7a94deb83ad132d7.
B12X=e4084d2e
DUAL_RAIL=1
ROCE_AR=1
PINNED_TACTICS=pinned-autotune-moe-v1.json
